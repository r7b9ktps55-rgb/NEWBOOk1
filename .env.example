# ===== Обязательно =====
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Логин и пароль для входа на сайт (пароль — не короче 10 символов)
WEB_USER=me
WEB_PASSWORD=

# ===== Сайт =====
PORT=8080
# 127.0.0.1 — только этот компьютер; 0.0.0.0 — вся локальная сеть
BIND=127.0.0.1
# Лимит размера одного файла книги
MAX_UPLOAD_MB=200
# HTTPS через Caddy (docker compose --profile https up -d): домен сервера
DOMAIN=
# За HTTPS-прокси: доверять заголовку X-Forwarded-For (чтобы видеть настоящие адреса)
FORWARDED_ALLOW_IPS=

# ===== Конспекты =====
# gemini-flash-latest — всегда актуальная Flash (Google предупреждает о смене за 2 недели).
# Можно закрепить конкретную модель из https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
# Форматы, отмеченные по умолчанию (через запятую):
# summary, brief, key, quotes, characters, cards, x2, x3, x4, x5
DEFAULT_FORMATS=summary
# Ежедневный автоматический разбор (пусто или off — выключить)
DAILY_RUN_TIME=09:00
# Сколько книг разбирать за один ежедневный запуск
DAILY_BATCH_SIZE=1
TIMEZONE=Europe/Saratov

# ===== Защита от лишних расходов =====
# Потолок запросов к Gemini на одну книгу (проверяется до первого запроса)
MAX_REQUESTS_PER_JOB=60
# Потолок запросов в сутки (0 — без лимита)
DAILY_REQUEST_LIMIT=300

# ===== Уведомления (необязательно) =====
# ntfy: https://ntfy.sh/длинный-случайный-топик
# Telegram: https://api.telegram.org/bot<токен>/sendMessage?chat_id=<id>&text={text}
NOTIFY_URL=

# ===== Резервные копии и корзина =====
# Во сколько делать копию (off — не делать), сколько хранить, куда класть
BACKUP_TIME=03:30
BACKUP_KEEP=7
# Лучше другой диск; по умолчанию data/backups
BACKUP_DIR=
# 1 — класть в копию и исходные книги (могут быть большими)
BACKUP_BOOKS=0
# Сколько дней удалённое лежит в корзине
TRASH_DAYS=30

# ===== Obsidian =====
# Имя хранилища для кнопки «Открыть в Obsidian» (пусто — текущее)
OBSIDIAN_VAULT_NAME=
OBSIDIAN_VAULT_SUBFOLDER=Books

# ===== Git-синхронизация хранилища (необязательно) =====
# Например https://github.com/you/obsidian-vault.git
GIT_REPO_URL=
# GitHub-токен с правом записи (Contents: Read and write) в этот репозиторий
GIT_TOKEN=
GIT_BRANCH=main
GIT_AUTHOR_NAME=Book Hub
GIT_AUTHOR_EMAIL=bookhub@localhost
