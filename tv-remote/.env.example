# Домен пульта. Если своего домена нет — используйте IP сервера через sslip.io:
# IP 203.0.113.10  ->  203-0-113-10.sslip.io
DOMAIN=203-0-113-10.sslip.io
# Пароль для входа в пульт (обязателен в облаке)
ACCESS_PIN=придумайте-пароль
# Секрет для домашних агентов (openssl rand -hex 24)
AGENT_TOKEN=замените-на-случайную-строку-из-48-символов
TZ=Europe/Moscow
